<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Exact alarms. USE_EXACT_ALARM (Android 13+) is for apps whose core feature is an alarm clock;
       SCHEDULE_EXACT_ALARM covers Android 12 / 12L, where it is granted by default. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <!-- Showing the alarm notification (asked for at runtime on Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Opening the alarm screen over the lock screen. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <receiver
      android:name="expo.modules.terbitalarms.AlarmReceiver"
      android:exported="false" />

    <activity
      android:name="expo.modules.terbitalarms.AlarmAlertActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity=""
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
  </application>
</manifest>
