# Terbit MY · public Supabase settings (Phase 2B).
#
# 1. Copy this file to `.env.local` (that name is git-ignored, so it's never committed).
# 2. Paste your project's values from Supabase → Project Settings → API Keys / Data API.
# 3. Restart `npm start` so Expo picks them up.
#
# Leave them empty to run Terbit MY local-only (no accounts).
#
# Only PUBLIC values go here. NEVER put the secret / service_role key in the app:
# the app refuses to start the cloud with one.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional (Phase 3C): where Reflection music is downloaded from. Leave empty to use the
# `reflection-music` bucket in the Supabase project above.
EXPO_PUBLIC_REFLECTION_MUSIC_BASE_URL=
